{
  "type": "module",
  "scripts": {
    "db:init": "tsx backend/src/database/initDb.ts",
    "backend:dev": "tsx watch backend/src/index.ts",
    "backend:build": "tsc && mkdir -p dist/backend/src/database && cp backend/src/database/seed_emergency_data.sql dist/backend/src/database/",
    "backend:start": "node dist/backend/src/index.js",
    "backend:test": "vitest run",
    "backend:test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
